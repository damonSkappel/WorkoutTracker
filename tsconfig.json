{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "utils/**/*.ts", "utils/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["components", "hooks", "constants", "scripts"]
}
